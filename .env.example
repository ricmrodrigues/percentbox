# Public site origin used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://percentbox.com

# Google Analytics 4 measurement id. Leave empty to disable GA.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# AdSense publisher id. Defaults to ca-pub-5355338650267313 when unset.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-5355338650267313

# Optional kill switch. Unset or true loads the Auto ads script.
# Set to false to stop injecting adsbygoogle.js. Slot ids are NOT required.
NEXT_PUBLIC_ADSENSE_ENABLED=

# Optional manual ad units from AdSense → Ads → By ad unit.
# Leave empty to rely on Auto ads only (no placeholder boxes).
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_BELOW=
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=
